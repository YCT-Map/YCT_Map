# Local development defaults are safe without this file.
# Set a unique private value outside version control for non-local environments.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
DEV_TUNNEL_HOST_SUFFIX=.trycloudflare.com
# Set only when a trusted production proxy overwrites X-Forwarded-Proto.
TRUST_PROXY_HTTPS=0
# Production hosting supplies these values outside Git.
DATABASE_URL=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=3600
